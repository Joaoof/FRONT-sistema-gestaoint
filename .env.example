# URL pública da sua API NestJS — usada por TODAS as chamadas REST.
# Em produção, defina isso no Netlify (Site settings → Build & deploy → Environment).
# Sem isso, requests caem no host do próprio front e retornam 404.
VITE_API_URL="http://localhost:3000"

# Endpoint GraphQL (Apollo Client). Geralmente é VITE_API_URL + /graphql.
VITE_GRAPHQL_ENDPOINT="http://localhost:3000/graphql"

# (Opcional) Override pra base do storage. Por padrão é VITE_API_URL + /api/storage.
# VITE_STORAGE_API="https://api.exemplo.com/api/storage"
